APP_NAME="PitWall IT Operations"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

PLATFORM_NAME="PitWall IT Operations"
SPA_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pitwall
DB_USERNAME=pitwall
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Sanctum uses cookie-based session auth for the SPA, so the SPA origin must be
# listed here. No API token is ever stored in the browser.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Microsoft Entra ID application registration (multi-tenant)
#
# Register ONE multi-tenant application. Customer tenants grant admin consent
# to it; the secret below is the platform's and must never reach the frontend.
# See docs/graph-permissions.md for the permissions to configure.
###############################################################################

MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MS_GRAPH_CONSENT_REDIRECT_URI="${APP_URL}/auth/microsoft/consent/callback"

MS_GRAPH_VERSION=v1.0
MS_GRAPH_LOG_REQUESTS=false

# Synchronisation intervals, in minutes.
SYNC_INTERVAL_USERS=15
SYNC_INTERVAL_GROUPS=15
SYNC_INTERVAL_DEVICES=15
SYNC_INTERVAL_APPLICATIONS=60
SYNC_INTERVAL_POLICIES=60

AUDIT_RETENTION_DAYS=730
DATA_STALE_AFTER_MINUTES=60

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
